PORT=3000

# --- Database (REQUIRED) ---
# Local dev (Homebrew Postgres): postgresql://<your-mac-username>@localhost:5432/golfapp_dev
# Production: your Neon/Supabase connection string (include ?sslmode=require for Neon).
DATABASE_URL=postgresql://USER@localhost:5432/golfapp_dev

# --- Auth ---
# Use a long random string in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-in-production

# --- Money mode ---
# Keep OFF. The app is a scorekeeper + settle-up tracker; no real money moves.
# Flip to "true" only after integrating a (gambling-capable) payment processor.
MONEY_ENABLED=false

# --- Email (Resend SMTP) — optional, for password reset emails ---
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=your-resend-api-key
# SMTP_FROM=noreply@yourdomain.com
# RESET_PASSWORD_BASE_URL=http://localhost:8081

